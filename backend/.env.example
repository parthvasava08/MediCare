# Copy to .env and fill in. NEVER commit the real .env.
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=

# Auth
JWT_SECRET=                      # long random string (e.g. `openssl rand -hex 32`)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_CLERK_USER_IDS=            # comma-separated Clerk user ids allowed into the admin panel
MAJOR_ADMIN_ID=                  # optional

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS / links in emails
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Optional: shared rate-limit store when running more than one instance
REDIS_URL=

# Optional: password-reset emails (if unset, the reset link is logged to the console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
